// ==========================================
// DAX Query View — Test All Measures First
// ==========================================
// In Power BI Desktop: Modeling → New query (DAX Query view)
// Paste each DEFINE block below, run with F5 to validate results.
// Then use Tabular Editor (bulk_measures.cs) to persist them.
// ==========================================

// === Test 1: Funnel KPIs ===
DEFINE
MEASURE 'Measures'[MQL Count] = COUNTROWS(dim_marketing)
MEASURE 'Measures'[Deals Won] = COUNTROWS(FILTER(dim_marketing, dim_marketing[seller_id] <> BLANK()))
MEASURE 'Measures'[Conversion Rate] = DIVIDE([Deals Won], [MQL Count], 0)

EVALUATE
ROW("MQLs", [MQL Count], "Deals", [Deals Won], "Conv%", [Conversion Rate])

// === Test 2: Revenue ===
DEFINE
MEASURE 'Measures'[Total Revenue] = SUM(fact_marketing[revenue])
MEASURE 'Measures'[Total Orders] = COUNTROWS(fact_marketing)
MEASURE 'Measures'[AOV] = DIVIDE([Total Revenue], [Total Orders], 0)

EVALUATE
ROW("Revenue", [Total Revenue], "Orders", [Total Orders], "AOV", [AOV])

// === Test 3: LTV ===
DEFINE
MEASURE 'Measures'[Total Revenue] = SUM(fact_marketing[revenue])
MEASURE 'Measures'[MQL Count] = COUNTROWS(dim_marketing)
MEASURE 'Measures'[Deals Won] = COUNTROWS(FILTER(dim_marketing, dim_marketing[seller_id] <> BLANK()))
MEASURE 'Measures'[LTV per MQL] = DIVIDE([Total Revenue], [MQL Count], 0)
MEASURE 'Measures'[LTV per Seller] = DIVIDE([Total Revenue], [Deals Won], 0)

EVALUATE
ROW("LTV/MQL", [LTV per MQL], "LTV/Seller", [LTV per Seller])

// === Test 4: Quality ===
DEFINE
MEASURE 'Measures'[Total Orders] = COUNTROWS(fact_marketing)
MEASURE 'Measures'[Avg Review Score] = AVERAGE(fact_marketing[review_score])
MEASURE 'Measures'[Late Delivery %] = DIVIDE(COUNTROWS(FILTER(fact_marketing, fact_marketing[is_late] = 1)), [Total Orders], 0)
MEASURE 'Measures'[Repeat Customer %] = DIVIDE(COUNTROWS(FILTER(fact_marketing, fact_marketing[is_repeat_customer] = 1)), [Total Orders], 0)
MEASURE 'Measures'[Avg Days to Close] = AVERAGE(fact_marketing[days_to_close])

EVALUATE
ROW(
    "Avg Score", [Avg Review Score],
    "Late%", [Late Delivery %],
    "Repeat%", [Repeat Customer %],
    "Avg Days", [Avg Days to Close]
)

// === Test 5: Counts by Channel (full cross-filter test) ===
DEFINE
MEASURE 'Measures'[MQL Count] = COUNTROWS(dim_marketing)
MEASURE 'Measures'[Deals Won] = COUNTROWS(FILTER(dim_marketing, dim_marketing[seller_id] <> BLANK()))
MEASURE 'Measures'[Conversion Rate] = DIVIDE([Deals Won], [MQL Count], 0)

EVALUATE
SUMMARIZE(
    dim_marketing,
    dim_marketing[origin],
    "MQLs", [MQL Count],
    "Deals", [Deals Won],
    "Conv%", [Conversion Rate]
)
ORDER BY [MQLs] DESC