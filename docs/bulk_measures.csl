// Bulk Measures — Marketing Funnel Dashboard
// ============================================
// METHOD: TMDL View (native in Power BI Desktop)
//
// STEPS:
//   1. Create empty Measures table:
//        Modeling → New Table → Measures = DATATABLE("x", INTEGER, {{1}})
//        Delete the "placeholder" column
//   2. Model view → click TMDL icon in ribbon
//   3. Paste everything below into the TMDL editor
//   4. Click "Apply" (top-left of TMDL editor)
//   5. All measures created with formatting and folders
//
// NOTE: Spaces not allowed in measure names — use underscores.
//       Use the DisplayFolder property to group them visually.
// ============================================

// ── FUNNEL ──────────────────────────────────
measure MQL_Count = COUNTROWS(dim_marketing)
    DisplayFolder = "Funnel"
    FormatString = "#,#0"

measure Deals_Won = COUNTROWS(FILTER(dim_marketing, dim_marketing[seller_id] <> BLANK()))
    DisplayFolder = "Funnel"
    FormatString = "#,#0"

measure Conversion_Rate = DIVIDE([Deals_Won], [MQL Count], 0)
    DisplayFolder = "Funnel"
    FormatString = "0.00%"

// ── REVENUE ─────────────────────────────────
measure Total_Revenue = SUM(fact_marketing[revenue])
    DisplayFolder = "Revenue"
    FormatString = "$#,##0.00"

measure Total_Orders = COUNTROWS(fact_marketing)
    DisplayFolder = "Revenue"
    FormatString = "#,#0"

measure AOV = DIVIDE([Total Revenue], [Total Orders], 0)
    DisplayFolder = "Revenue"
    FormatString = "$#,##0.00"

measure LTV_per_MQL = DIVIDE([Total Revenue], [MQL Count], 0)
    DisplayFolder = "Revenue"
    FormatString = "$#,##0.00"

measure LTV_per_Seller = DIVIDE([Total Revenue], [Deals Won], 0)
    DisplayFolder = "Revenue"
    FormatString = "$#,##0.00"

// ── QUALITY ─────────────────────────────────
measure Avg_Review_Score = AVERAGE(fact_marketing[review_score])
    DisplayFolder = "Quality"
    FormatString = "0.0"

measure Late_Delivery_Percentage = DIVIDE(COUNTROWS(FILTER(fact_marketing, fact_marketing[is_late] = 1)), [Total Orders], 0)
    DisplayFolder = "Quality"
    FormatString = "0.00%"

measure Repeat_Customer_Percentage = DIVIDE(COUNTROWS(FILTER(fact_marketing, fact_marketing[is_repeat_customer] = 1)), [Total Orders], 0)
    DisplayFolder = "Quality"
    FormatString = "0.00%"

measure Avg_Days_to_Close = AVERAGE(fact_marketing[days_to_close])
    DisplayFolder = "Quality"
    FormatString = "0.0"

// ── COUNTS ──────────────────────────────────
measure Unique_Sellers = COUNTROWS(dim_seller)
    DisplayFolder = "Counts"
    FormatString = "#,#0"